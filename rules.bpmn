<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ControlBalanceSheet" targetNamespace="http://example.com/bpmn/control-balance-sheet" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:process id="Process_ControlBalanceSheet" name="Control balance sheet and compulsory liquidation (25:13-17 ABL)" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Possible capital deficiency (25:13 ABL)">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Q1_1" name="Q1.1 Does the board have reason to assume that equity, calculated under Ch. 25 Sec. 14 Companies Act, is below half of the registered share capital? (Ch. 25 Sec. 13 para. 1 pt. 1 Companies Act)">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q1_2" name="Q1.2 Has enforcement under Ch. 4 Enforcement Code shown that the company lacks assets to pay the claim in full? (Ch. 25 Sec. 13 para. 1 pt. 2 Companies Act)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_1" name="No duty to prepare a control balance sheet; no liquidation process under Ch. 25 Secs. 13–17 Companies Act">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q2_1" name="Q2.1 Has the board prepared a control balance sheet under Ch. 25 Sec. 14 Companies Act (ordinary balance sheet with the permitted adjustments of assets, liabilities, provisions and untaxed reserves)?(Ch. 25 Sec. 14 Companies Act)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Liab_1" name="Control balance sheet missing – duty under Ch. 25 Secs. 13–14 Companies Act not fulfilled. Personal liability is outside the scope of this assessment (Ch. 25 Secs. 18–20 a Companies Act)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q2_2" name="Q2.2 Has the control balance sheet been reviewed by the company’s auditor, or does the company neither have nor have to have an auditor? (Ch. 25 Sec. 13 and Ch. 1 Sec. 12 b Companies Act)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q2_3" name="Q2.3 Is equity under Ch. 25 Sec. 14 Companies Act (adjusted assets minus adjusted liabilities, with untaxed reserves split into equity and deferred tax) below half of the registered share capital? (Ch. 25 Sec. 15 para. 1 Companies Act)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_2" name="No critical capital deficiency; no duty to hold a control meeting under Ch. 25 Sec. 15 Companies Act">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q3_1" name="Q3.1 Has the board, as soon as possible, issued notice of the first control meeting? (Ch. 25 Sec. 15 para. 1 Companies Act)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Liab_2" name="First control meeting not convened. Personal liability is outside the scope of this assessment (Ch. 25 Secs. 18–20 a Companies Act)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q3_2" name="Q3.2 Was the first control meeting held with the control balance sheet and the auditor&#39;s statement presented? (Ch. 25 Sec. 15 para. 2 Companies Act)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q3_3" name="Q3.3 Did the first control meeting resolve that the company shall go into liquidation? (Ch. 25 Sec. 15 para. 1 and Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_3" name="The company goes into voluntary liquidation (Ch. 25 Sec. 1 Companies Act); no compulsory liquidation under Ch. 25 Sec. 17 Companies Act">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q3_4" name="Q3.4 Did the control balance sheet at the first meeting show equity at least equal to the registered share capital? (Ch. 25 Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_R1" name="No second control meeting required (Ch. 25 Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q4_1a" name="Q4.1a Has the second control meeting been held? (Ch. 25 Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q4_1b" name="Q4.1b Was it held within 8 months of the first meeting, or, after a company reorganisation during that period, within 2 months after the reorganisation ended? (Ch. 25 Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q4_1c" name="Q4.1c Has the deadline (8 months, or 2 months after a company reorganisation ended) passed? (Ch. 25 Sec. 16 para. 1 Companies Act)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_P" name="Deadline not yet passed – the second control meeting must still be held (Ch. 25 Sec. 16 Companies Act)">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q4_2" name="Q4.2 Has the board prepared a new control balance sheet under Ch. 25 Sec. 14 Companies Act before the second control meeting? (Ch. 25 Sec. 16 para. 2 Companies Act)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q4_3" name="Q4.3 Has the new control balance sheet been reviewed by the company’s auditor, or does the company neither have nor have to have an auditor? (Ch. 25 Sec. 16 para. 2, Sec. 17 para. 1 pt. 2 and Ch. 1 Sec. 12 b Companies Act)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q4_4" name="Q4.4 Is equity under Ch. 25 Sec. 14 Companies Act, at the time of the second control meeting, at least equal to the registered share capital? (Ch. 25 Sec. 17 para. 1 pt. 2 Companies Act)">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q4_5" name="Q4.5 Was a control balance sheet showing equity of at least the registered share capital presented at the second control meeting? (Ch. 25 Sec. 16 para. 2 and Sec. 17 para. 1 pt. 2 Companies Act)">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_4" name="No duty to liquidate due to capital deficiency; no compulsory liquidation under Ch. 25 Sec. 17 Companies Act">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q4_6" name="Q4.6 Did the second control meeting resolve that the company shall go into liquidation? (Ch. 25 Sec. 17 para. 1 pt. 2 Companies Act)">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_5" name="The company goes into voluntary liquidation; no compulsory liquidation under Ch. 25 Sec. 17 Companies Act">
      <bpmn:incoming>Flow_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q5_1" name="Q5.1 Ground for liquidation under Ch. 25 Sec. 17 para. 1 Companies Act: Has an application for liquidation been filed with the district court (by the board, which must apply within two weeks, or by a board member, the managing director, an auditor of the company or a shareholder)? (Ch. 25 Sec. 17 para. 2 Companies Act)">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Liab_4" name="No application filed – the board must apply within 2 weeks. Personal liability is outside the scope of this assessment (Ch. 25 Secs. 18–20 a Companies Act)">
      <bpmn:incoming>Flow_36</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q5_2" name="Q5.2 During the court proceedings, has a control balance sheet showing equity at least equal to the registered share capital been reviewed by the auditor and presented at a general meeting? (Ch. 25 Sec. 17 para. 3 Companies Act)">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_7" name="The district court shall not order liquidation; no compulsory liquidation (Ch. 25 Sec. 17 para. 3 Companies Act)">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Q5_3" name="Q5.3 Does the ground for liquidation under Ch. 25 Sec. 17 para. 1 Companies Act still exist (no second control meeting in time, or the control balance sheet at the second control meeting was not reviewed or did not show equity of at least the registered share capital, and the meeting did not resolve on liquidation)? (Ch. 25 Sec. 17 paras. 1 and 3 Companies Act)">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_8" name="The district court shall order the company into liquidation, effective immediately (Ch. 25 Sec. 17 paras. 1 and 4 Companies Act)">
      <bpmn:incoming>Flow_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_9" name="No compulsory liquidation (Ch. 25 Sec. 17 Companies Act)">
      <bpmn:incoming>Flow_40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Start_1" targetRef="Q1_1" />
    <bpmn:sequenceFlow id="Flow_1" name="Yes" sourceRef="Q1_1" targetRef="Q2_1" />
    <bpmn:sequenceFlow id="Flow_2" name="No" sourceRef="Q1_1" targetRef="Q1_2" />
    <bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="Q1_2" targetRef="Q2_1" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="Q1_2" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="Q2_1" targetRef="Q2_2" />
    <bpmn:sequenceFlow id="Flow_6" name="No – formal defect" sourceRef="Q2_1" targetRef="Liab_1" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Q2_2" targetRef="Q2_3" />
    <bpmn:sequenceFlow id="Flow_8" name="No – defect noted: auditor review missing" sourceRef="Q2_2" targetRef="Q2_3" />
    <bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="Q2_3" targetRef="Q3_1" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Q2_3" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Q3_1" targetRef="Q3_2" />
    <bpmn:sequenceFlow id="Flow_12" name="No – defect: not convened" sourceRef="Q3_1" targetRef="Liab_2" />
    <bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="Q3_2" targetRef="Q3_3" />
    <bpmn:sequenceFlow id="Flow_14" name="No – defect noted: meeting not held correctly" sourceRef="Q3_2" targetRef="Q3_3" />
    <bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="Q3_3" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="Q3_3" targetRef="Q3_4" />
    <bpmn:sequenceFlow id="Flow_17" name="Yes" sourceRef="Q3_4" targetRef="End_R1" />
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Q3_4" targetRef="Q4_1a" />
    <bpmn:sequenceFlow id="Flow_19" name="Yes" sourceRef="Q4_1a" targetRef="Q4_1b" />
    <bpmn:sequenceFlow id="Flow_20" name="No" sourceRef="Q4_1a" targetRef="Q4_1c" />
    <bpmn:sequenceFlow id="Flow_21" name="Yes" sourceRef="Q4_1b" targetRef="Q4_2" />
    <bpmn:sequenceFlow id="Flow_22" name="No – ground under 25:17 st. 1 p. 1" sourceRef="Q4_1b" targetRef="Q5_1" />
    <bpmn:sequenceFlow id="Flow_23" name="Yes – ground under 25:17 st. 1 p. 1" sourceRef="Q4_1c" targetRef="Q5_1" />
    <bpmn:sequenceFlow id="Flow_24" name="No" sourceRef="Q4_1c" targetRef="End_P" />
    <bpmn:sequenceFlow id="Flow_25" name="Yes" sourceRef="Q4_2" targetRef="Q4_3" />
    <bpmn:sequenceFlow id="Flow_26" name="No – defect: no new control balance sheet" sourceRef="Q4_2" targetRef="Q4_6" />
    <bpmn:sequenceFlow id="Flow_27" name="Yes" sourceRef="Q4_3" targetRef="Q4_4" />
    <bpmn:sequenceFlow id="Flow_28" name="No – defect: auditor review missing" sourceRef="Q4_3" targetRef="Q4_6" />
    <bpmn:sequenceFlow id="Flow_29" name="Yes" sourceRef="Q4_4" targetRef="Q4_5" />
    <bpmn:sequenceFlow id="Flow_30" name="No" sourceRef="Q4_4" targetRef="Q4_6" />
    <bpmn:sequenceFlow id="Flow_31" name="Yes" sourceRef="Q4_5" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_32" name="No" sourceRef="Q4_5" targetRef="Q4_6" />
    <bpmn:sequenceFlow id="Flow_33" name="Yes" sourceRef="Q4_6" targetRef="End_5" />
    <bpmn:sequenceFlow id="Flow_34" name="No – ground under 25:17 st. 1 p. 2" sourceRef="Q4_6" targetRef="Q5_1" />
    <bpmn:sequenceFlow id="Flow_35" name="Yes" sourceRef="Q5_1" targetRef="Q5_2" />
    <bpmn:sequenceFlow id="Flow_36" name="No" sourceRef="Q5_1" targetRef="Liab_4" />
    <bpmn:sequenceFlow id="Flow_37" name="Yes" sourceRef="Q5_2" targetRef="End_7" />
    <bpmn:sequenceFlow id="Flow_38" name="No" sourceRef="Q5_2" targetRef="Q5_3" />
    <bpmn:sequenceFlow id="Flow_39" name="Yes" sourceRef="Q5_3" targetRef="End_8" />
    <bpmn:sequenceFlow id="Flow_40" name="No" sourceRef="Q5_3" targetRef="End_9" />
  </bpmn:process>
